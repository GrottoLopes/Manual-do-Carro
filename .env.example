# Copie este arquivo para ".env" e preencha com seus dados reais.
# NUNCA suba o arquivo ".env" pro Git (ele já está no .gitignore).

# String de conexão do PostgreSQL.
# Se usar Neon, Supabase ou Railway, eles te dão essa URL pronta no painel.
DATABASE_URL="postgresql://usuario:senha@localhost:5432/manual_do_carro?schema=public"

# Porta e host da API
PORT=3000
HOST=0.0.0.0

# Segredo usado para assinar os tokens JWT (use uma string longa e aleatória)
JWT_SECRET="troque_isso_por_um_segredo_forte_e_aleatorio"

# Tempo de expiração do token (ex: 1h, 7d, 30d)
JWT_EXPIRES_IN="7d"
